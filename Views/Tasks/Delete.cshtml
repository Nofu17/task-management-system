@model TaskManagementSystem.Models.TaskModel

@{
    ViewData["Title"] = "Delete Task";
}

<h1 class="text-center text-danger mb-4">Delete Task</h1>

<div class="card shadow p-4" style="max-width: 600px; margin: auto; background-color: #fff4f4;">
    <h5 class="text-danger fw-bold mb-3">Are you sure you want to delete this task?</h5>

    <dl class="row">
        <dt class="col-sm-4 fw-bold">Title</dt>
        <dd class="col-sm-8">@Model.Title</dd>

        <dt class="col-sm-4 fw-bold">Description</dt>
        <dd class="col-sm-8">@Model.Description</dd>

        <dt class="col-sm-4 fw-bold">Status</dt>
        <dd class="col-sm-8">@Model.Status</dd>

        <dt class="col-sm-4 fw-bold">Due Date</dt>
        <dd class="col-sm-8">@Model.DueDate.ToShortDateString()</dd>
    </dl>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-between mt-4">
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-danger">Delete</button>
        </div>
    </form>
</div>

