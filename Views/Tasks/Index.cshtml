@model IEnumerable<TaskManagementSystem.Models.TaskModel>

@{
    ViewData["Title"] = "My Tasks";
}

<h1 class="mb-4">My Tasks</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Task</a>
</p>

<form asp-controller="Tasks" asp-action="Index" method="get" class="mb-3">
    <label for="statusFilter">Filter by status:</label>
    <select name="statusFilter" asp-items="ViewBag.StatusFilter" onchange="this.form.submit()" class="form-control" style="width:200px; display:inline-block;">
        <option value="">All</option>
    </select>
</form>

<a asp-action="Index" asp-route-statusFilter="@Context.Request.Query["statusFilter"]" asp-route-sortOrder="@ViewBag.SortOrder" class="btn btn-outline-primary mb-3">
    Sort by Due Date (@(ViewBag.SortOrder == "desc" ? "Descending" : "Ascending"))
</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Status</th>
            <th>Due Date</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>
                    @if (item.Status == "To Do")
                    {
                        <span class="badge bg-primary">@item.Status</span>
                    }
                    else if (item.Status == "In Progress")
                    {
                        <span class="badge bg-warning text-dark">@item.Status</span>
                    }
                    else if (item.Status == "Done")
                    {
                        <span class="badge bg-success">@item.Status</span>
                    }
                    else
                    {
                        @item.Status
                    }
                </td>
                <td>@item.DueDate.ToShortDateString()</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

